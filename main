import React, { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { Copy, Eye, Music, Plus, Trash2, Wand2 } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";

export default function CcfoliaBackupPreviewSite() {
  const [rawHtml, setRawHtml] = useState("");
  const [roomId, setRoomId] = useState("");
  const [bgms, setBgms] = useState([
    { title: "To Dream", url: "" },
    { title: "蝶の道草", url: "" },
  ]);
  const [characters, setCharacters] = useState([
    { name: "", width: "160", height: "160", left: "0", top: "0", imageUrl: "" },
  ]);
  const [copied, setCopied] = useState(false);

  const cleanRoomId = roomId
    .trim()
    .replace(/^https?:\/\/ccfolia\.com\/rooms\//, "")
    .replace(/\/chat.*$/, "")
    .replace(/\?.*$/, "")
    .replace(/\/$/, "");

  const roomChatUrl = cleanRoomId ? `https://ccfolia.com/rooms/${cleanRoomId}/chat` : "";

  const bgmButtons = useMemo(() => {
    return bgms
      .filter((b) => b.title.trim() || b.url.trim())
      .map(
        (b) =>
          `<p style="text-align:center;"><button class="bgmButton" data-audio="${escapeHtml(
            b.url
          )}" data-label="${escapeHtml(b.title)}">♪ ${escapeHtml(b.title || "BGM")}</button></p>`
      )
      .join("\n");
  }, [bgms]);

  const characterRules = useMemo(() => {
    return characters
      .filter((c) => c.name.trim())
      .map(
        (c) => `
  // ${c.name} 인장 강제 변경 + 인장 안 이미지 조정
  if (nameText.includes("${escapeJs(c.name)}")) {
    ${c.imageUrl?.trim() ? `img.src = "${escapeJs(c.imageUrl.trim())}";` : ""}
    img.style.width = "${Number(c.width) || 100}%";
    img.style.height = "${Number(c.height) || 100}%";
    img.style.marginLeft = "${Number(c.left) || 0}%";
    img.style.marginTop = "${Number(c.top) || 0}%";
  }`
      )
      .join("
");
  }, [characters]);

  const finalCode = useMemo(() => {
    return `${bgmButtons ? `${bgmButtons}\n\n` : ""}<div class="ccfolia_backup_area">
${rawHtml || "<!-- 여기에 코코포리아 로그 HTML이 들어갑니다 -->"}
</div>

<style>
/* ===== 코코포리아 티스토리 백업 기본 스타일 ===== */
.ccfolia_backup_area {
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
  box-sizing: border-box;
  font-size: 15px;
  line-height: 1.8;
}

.ccfolia_backup_area .ccfolia_wrap {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.ccfolia_backup_area .gap.message-row {
  box-sizing: border-box;
}

.ccfolia_backup_area .msg_container {
  box-sizing: border-box;
}

.ccfolia_backup_area .msg-timestamp,
.ccfolia_backup_area .msg-category-tag {
  display: none !important;
}

.ccfolia_backup_area .cc-system-line {
  display: block !important;
  width: 100% !important;
  text-align: center !important;
  margin: 1.2em auto !important;
}

.ccfolia_backup_area .cc-system-line .msg_container,
.ccfolia_backup_area .cc-system-line .msg-body,
.ccfolia_backup_area .cc-system-line .msg-main,
.ccfolia_backup_area .cc-system-line .msg-text {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 auto !important;
  text-align: center !important;
}

.bgmButton {
  display: inline-block;
  margin: 8px 4px;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.06);
  color: inherit;
  font-size: 13px;
  cursor: pointer;
}

.bgmButton:hover {
  background: rgba(255,255,255,0.12);
}

@media (max-width: 768px) {
  .ccfolia_backup_area {
    max-width: 100%;
    padding: 0 12px;
    font-size: 14px;
  }

  .ccfolia_backup_area .ccfolia_wrap {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
  }
}
</style>

<script>
(function () {
  const root = document.querySelector('.ccfolia_backup_area');
  if (!root) return;

  // 날짜 / HO 태그 삭제
  root.querySelectorAll('.msg-timestamp, .msg-category-tag').forEach(el => el.remove());

  // blank.gif 처리: 이름 없는 시스템 로그만 인장 삭제 + 중앙정렬
  root.querySelectorAll('.gap.message-row').forEach(row => {
    const nameEl = row.querySelector('.msg-name');
    const iconImg = row.querySelector('img');
    const nameText = nameEl ? nameEl.textContent.trim() : '';
    const src = iconImg ? iconImg.getAttribute('src') || '' : '';
    const isBlankIcon = src.includes('blank.gif') || src.includes('blank');

    if (!nameText && isBlankIcon) {
      if (iconImg) {
        const iconBox = iconImg.closest('.msg_icon, .msg-icon, .icon, .avatar') || iconImg.parentElement;
        if (iconBox) iconBox.remove();
        else iconImg.remove();
      }
      row.classList.add('cc-system-line');
    }
  });

  // 캐릭터별 인장 안 이미지 조정
  root.querySelectorAll('.gap.message-row').forEach(row => {
    const nameEl = row.querySelector('.msg-name');
    const img = row.querySelector('img');
    if (!nameEl || !img) return;
    const nameText = nameEl.textContent.trim();
${characterRules || "    // 여기에 캐릭터별 인장 조정 규칙이 들어갑니다."}
  });

  // BGM 버튼
  let currentAudio = null;
  document.querySelectorAll('.bgmButton').forEach(button => {
    const src = button.dataset.audio;
    const label = button.dataset.label || button.textContent.replace('♪', '').trim() || 'BGM';
    button.textContent = '♪ ' + label;

    button.addEventListener('click', () => {
      if (!src) return;
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }
      currentAudio = new Audio(src);
      currentAudio.loop = true;
      currentAudio.play();
    });
  });
})();
</script>`;
  }, [rawHtml, bgmButtons, characterRules]);

  const previewHtml = useMemo(() => finalCode, [finalCode]);

  const copyCode = async () => {
    await navigator.clipboard.writeText(finalCode);
    setCopied(true);
    setTimeout(() => setCopied(false), 1500);
  };

  return (
    <div className="min-h-screen bg-neutral-950 text-neutral-100 p-4 md:p-8">
      <motion.div
        initial={{ opacity: 0, y: 12 }}
        animate={{ opacity: 1, y: 0 }}
        className="mx-auto max-w-7xl space-y-6"
      >
        <header className="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 className="text-2xl md:text-4xl font-bold tracking-tight">코코포리아 로그 백업 생성기</h1>
            <p className="mt-2 text-sm md:text-base text-neutral-400">
              로그 HTML을 붙여넣고, BGM과 인장 조정을 넣은 뒤 티스토리용 코드를 미리보기로 확인하세요.
            </p>
          </div>
          <Button onClick={copyCode} className="rounded-2xl">
            <Copy className="mr-2 h-4 w-4" /> {copied ? "복사 완료" : "최종 코드 복사"}
          </Button>
        </header>

        <div className="grid grid-cols-1 xl:grid-cols-2 gap-6">
          <section className="space-y-6">
            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl">
              <CardContent className="p-5 space-y-3">
                <div className="flex items-center gap-2 text-lg font-semibold">
                  <Wand2 className="h-5 w-5" /> 0. 룸 ID로 채팅창 불러오기
                </div>
                <input
                  value={roomId}
                  onChange={(e) => setRoomId(e.target.value)}
                  placeholder="룸 ID 또는 https://ccfolia.com/rooms/룸ID 주소"
                  className="w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-sm text-neutral-100 outline-none focus:border-neutral-500"
                />
                <p className="text-xs text-neutral-400">
                  코코포리아 로그인/권한 문제로 사이트 안에서 바로 안 보일 수 있어요. 그럴 땐 아래 링크를 새 창으로 열고, 로그 HTML을 복사해서 1번 칸에 붙여넣으면 됩니다.
                </p>
                {roomChatUrl && (
                  <a
                    href={roomChatUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="inline-flex rounded-2xl bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-950"
                  >
                    코코포리아 채팅창 새 창으로 열기
                  </a>
                )}
              </CardContent>
            </Card>

            {roomChatUrl && (
              <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl overflow-hidden">
                <CardContent className="p-0">
                  <div className="border-b border-neutral-800 p-4 text-sm font-semibold">
                    룸 채팅 미리보기 시도
                  </div>
                  <iframe
                    title="ccfolia-room-chat"
                    src={roomChatUrl}
                    className="h-[360px] w-full bg-white"
                  />
                </CardContent>
              </Card>
            )}

            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl">
              <CardContent className="p-5 space-y-3">
                <div className="flex items-center gap-2 text-lg font-semibold">
                  <Wand2 className="h-5 w-5" /> 1. 코코포리아 로그 HTML
                </div>
                <textarea
                  value={rawHtml}
                  onChange={(e) => setRawHtml(e.target.value)}
                  placeholder="코코포리아에서 백업한 HTML을 여기에 붙여넣기"
                  className="min-h-64 w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-sm text-neutral-100 outline-none focus:border-neutral-500"
                />
              </CardContent>
            </Card>

            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl">
              <CardContent className="p-5 space-y-4">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2 text-lg font-semibold">
                    <Music className="h-5 w-5" /> 2. BGM 버튼
                  </div>
                  <Button
                    variant="secondary"
                    className="rounded-2xl"
                    onClick={() => setBgms([...bgms, { title: "", url: "" }])}
                  >
                    <Plus className="mr-2 h-4 w-4" /> 추가
                  </Button>
                </div>
                <div className="space-y-3">
                  {bgms.map((b, i) => (
                    <div key={i} className="grid grid-cols-12 gap-2">
                      <input
                        value={b.title}
                        onChange={(e) => updateBgm(i, "title", e.target.value, bgms, setBgms)}
                        placeholder="노래 제목"
                        className="col-span-5 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <input
                        value={b.url}
                        onChange={(e) => updateBgm(i, "url", e.target.value, bgms, setBgms)}
                        placeholder="오디오 URL"
                        className="col-span-6 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <Button
                        variant="ghost"
                        className="col-span-1 rounded-xl px-2"
                        onClick={() => setBgms(bgms.filter((_, idx) => idx !== i))}
                      >
                        <Trash2 className="h-4 w-4" />
                      </Button>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>

            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl">
              <CardContent className="p-5 space-y-4">
                <div className="flex items-center justify-between">
                  <div className="text-lg font-semibold">3. 캐릭터 인장 안 이미지 조정</div>
                  <Button
                    variant="secondary"
                    className="rounded-2xl"
                    onClick={() =>
                      setCharacters([...characters, { name: "", width: "160", height: "160", left: "0", top: "0", imageUrl: "" }])
                    }
                  >
                    <Plus className="mr-2 h-4 w-4" /> 추가
                  </Button>
                </div>
                <div className="space-y-3">
                  {characters.map((c, i) => (
                    <div key={i} className="grid grid-cols-12 gap-2">
                      <input
                        value={c.name}
                        onChange={(e) => updateCharacter(i, "name", e.target.value, characters, setCharacters)}
                        placeholder="캐릭터 이름"
                        className="col-span-4 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <input
                        value={c.imageUrl}
                        onChange={(e) => updateCharacter(i, "imageUrl", e.target.value, characters, setCharacters)}
                        placeholder="교체할 인장 이미지 URL"
                        className="col-span-7 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <Button
                        variant="ghost"
                        className="col-span-1 rounded-xl px-2"
                        onClick={() => setCharacters(characters.filter((_, idx) => idx !== i))}
                      >
                        <Trash2 className="h-4 w-4" />
                      </Button>
                      <input
                        value={c.width}
                        onChange={(e) => updateCharacter(i, "width", e.target.value, characters, setCharacters)}
                        placeholder="W%"
                        className="col-span-3 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <input
                        value={c.height}
                        onChange={(e) => updateCharacter(i, "height", e.target.value, characters, setCharacters)}
                        placeholder="H%"
                        className="col-span-3 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <input
                        value={c.left}
                        onChange={(e) => updateCharacter(i, "left", e.target.value, characters, setCharacters)}
                        placeholder="Left%"
                        className="col-span-3 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                      <input
                        value={c.top}
                        onChange={(e) => updateCharacter(i, "top", e.target.value, characters, setCharacters)}
                        placeholder="Top%"
                        className="col-span-3 rounded-xl border border-neutral-800 bg-neutral-950 p-3 text-sm outline-none"
                      />
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          </section>

          <section className="space-y-6">
            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl overflow-hidden">
              <CardContent className="p-0">
                <div className="flex items-center gap-2 border-b border-neutral-800 p-4 text-lg font-semibold">
                  <Eye className="h-5 w-5" /> 미리보기
                </div>
                <iframe
                  title="preview"
                  srcDoc={previewHtml}
                  className="h-[620px] w-full bg-white text-black"
                />
              </CardContent>
            </Card>

            <Card className="bg-neutral-900 border-neutral-800 rounded-2xl shadow-xl">
              <CardContent className="p-5 space-y-3">
                <div className="flex items-center justify-between">
                  <div className="text-lg font-semibold">최종 코드</div>
                  <Button variant="secondary" onClick={copyCode} className="rounded-2xl">
                    <Copy className="mr-2 h-4 w-4" /> 복사
                  </Button>
                </div>
                <textarea
                  readOnly
                  value={finalCode}
                  className="min-h-80 w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-xs text-neutral-200 outline-none"
                />
              </CardContent>
            </Card>
          </section>
        </div>
      </motion.div>
    </div>
  );
}

function updateBgm(index, key, value, bgms, setBgms) {
  const next = [...bgms];
  next[index] = { ...next[index], [key]: value };
  setBgms(next);
}

function updateCharacter(index, key, value, characters, setCharacters) {
  const next = [...characters];
  next[index] = { ...next[index], [key]: value };
  setCharacters(next);
}

function escapeHtml(str) {
  return String(str || "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function escapeJs(str) {
  return String(str || "").replaceAll("\\", "\\\\").replaceAll('"', '\\"');
}
